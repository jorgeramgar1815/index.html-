---
/**
 * Panel del negocio: inicio (resumen del día), agenda (día / semana), bloqueos y "Mi página".
 * El diseño es de Agendo (neutro); se personaliza con el nombre y datos del negocio del usuario.
 * Acceso con Supabase Auth; cada usuario sólo ve el negocio que tiene en `admins` (RLS).
 */
import App from '../layouts/App.astro';
import Logo from '../components/Logo.astro';
import { APP, SUPABASE, configurado } from '../config';
import { icono, type NombreIcono } from '../scripts/iconos';

const secciones: { id: string; nombre: string; icono: NombreIcono }[] = [
  { id: 'inicio', nombre: 'Inicio', icono: 'inicio' },
  { id: 'agenda', nombre: 'Agenda', icono: 'agenda' },
  { id: 'bloqueos', nombre: 'Bloqueos', icono: 'bloqueos' },
  { id: 'pagina', nombre: 'Mi página', icono: 'pagina' },
];
---

<App title={`Panel · ${APP.nombre}`} noindex>
  {
    !configurado ? (
      <main class="mx-auto grid min-h-dvh max-w-md place-items-center px-6 text-center">
        <div>
          <Logo />
          <p class="mt-4 text-suave">
            Falta configurar Supabase (<code>PUBLIC_SUPABASE_URL</code> y <code>PUBLIC_SUPABASE_ANON_KEY</code>).
          </p>
        </div>
      </main>
    ) : (
      <div id="panel" data-url={SUPABASE.url} data-key={SUPABASE.anonKey}>
        <!-- Cargando sesión -->
        <div id="vista-cargando" class="grid min-h-dvh place-items-center">
          <div class="size-9 animate-spin rounded-full border-[3px] border-marca-100 border-t-marca" role="status" aria-label="Cargando" />
        </div>

        <!-- Acceso -->
        <main id="vista-login" class="grid min-h-dvh place-items-center px-4 py-10" hidden>
          <div class="w-full max-w-sm">
            <div class="text-center"><Logo /></div>
            <form id="form-login" class="tarjeta mt-6 p-6 sm:p-8" novalidate>
              <h1 class="text-2xl font-bold tracking-tight">Entra a tu panel</h1>
              <p class="mt-1.5 text-sm text-suave">Administra las citas de tu negocio.</p>
              <label class="campo mt-6">
                <span>Correo</span>
                <input name="email" type="email" autocomplete="username" required />
              </label>
              <label class="campo mt-4">
                <span>Contraseña</span>
                <input name="password" type="password" autocomplete="current-password" required />
              </label>
              <p id="login-error" class="mt-4 rounded-xl bg-orange-50 px-3.5 py-2.5 text-sm font-medium text-peligro" role="alert" hidden />
              <button type="submit" class="btn btn-primario btn-lg mt-6 w-full">Entrar</button>
            </form>
            <p class="mt-6 text-center text-xs text-tenue">{APP.lema}</p>
          </div>
        </main>

        <!-- Panel -->
        <div id="vista-panel" hidden>
          <!-- Barra lateral (escritorio) -->
          <aside class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-borde bg-superficie lg:flex">
            <div class="flex items-center gap-3 border-b border-borde px-5 py-5">
              <div class="p-avatar size-11 text-base" data-p-iniciales>··</div>
              <div class="min-w-0">
                <p class="truncate font-bold text-texto" data-p-nombre>Tu negocio</p>
                <p class="truncate text-xs text-suave" data-p-giro>Panel de citas</p>
              </div>
            </div>
            <nav class="grid gap-1 p-3" aria-label="Secciones">
              {
                secciones.map((s) => (
                  <a href={`#${s.id}`} class="p-nav" data-ir={s.id}>
                    <Fragment set:html={icono(s.icono)} />
                    <span class="flex-1">{s.nombre}</span>
                    {s.id === 'inicio' && <span class="p-contador" data-p-contador hidden />}
                  </a>
                ))
              }
            </nav>
            <div class="mt-auto grid gap-2 border-t border-borde p-3">
              <button type="button" class="p-nav" data-p-avisos>
                <span data-p-avisos-icono />
                <span class="flex-1 text-left" data-p-avisos-texto>Avisos</span>
              </button>
              <p class="flex items-center gap-2 px-3 text-xs text-suave">
                <span class="p-vivo" data-p-vivo /><span data-p-vivo-texto>Conectando…</span>
              </p>
              <button type="button" class="p-nav" data-p-salir>
                <Fragment set:html={icono('salir')} /><span>Salir</span>
              </button>
              <div class="flex items-center gap-2 px-3 pt-2 text-xs text-tenue">
                <Logo compacto class="scale-75 origin-left" /><span class="-ml-2">con {APP.nombre}</span>
              </div>
            </div>
          </aside>

          <!-- Barra superior (móvil) -->
          <header class="sticky top-0 z-30 border-b border-borde bg-superficie/90 backdrop-blur lg:hidden">
            <div class="flex h-16 items-center gap-3 px-4">
              <div class="p-avatar size-9 text-sm" data-p-iniciales>··</div>
              <div class="min-w-0 flex-1">
                <p class="truncate font-bold leading-tight text-texto" data-p-nombre>Tu negocio</p>
                <p class="flex items-center gap-1.5 text-xs text-suave"><span class="p-vivo" data-p-vivo /><span data-p-vivo-texto>Conectando…</span></p>
              </div>
              <button type="button" class="p-icono-btn" data-p-avisos aria-label="Avisos"><span data-p-avisos-icono /></button>
              <button type="button" class="p-icono-btn" data-p-salir aria-label="Salir"><Fragment set:html={icono('salir')} /></button>
            </div>
          </header>

          <main class="pb-28 lg:pb-12 lg:pl-64">
            <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-10 lg:py-10">
              <!-- Inicio -->
              <section data-seccion="inicio" aria-labelledby="t-inicio">
                <div class="flex flex-wrap items-end justify-between gap-4">
                  <div>
                    <p class="text-sm font-medium text-suave first-letter:uppercase" data-p-hoy-fecha />
                    <h1 id="t-inicio" class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl" data-p-saludo>Hola</h1>
                  </div>
                  <a href="#agenda" class="btn btn-secundario hidden sm:inline-flex">
                    <Fragment set:html={icono('agenda', 18)} />Ver agenda completa
                  </a>
                </div>
                <div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4" data-p-kpis>
                  {[1, 2, 3, 4].map(() => <div class="esqueleto h-[6.5rem] rounded-[var(--radius-tarjeta)]" />)}
                </div>
                <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
                  <div class="grid content-start gap-6">
                    <div data-p-siguiente />
                    <section class="tarjeta p-5 sm:p-6" aria-labelledby="t-pendientes">
                      <div class="flex items-center justify-between gap-3">
                        <h2 id="t-pendientes" class="text-lg font-bold">Por confirmar</h2>
                        <span class="estado" data-estado="pendiente" data-p-pendientes-num hidden />
                      </div>
                      <p class="mt-1 text-sm text-suave">Citas que llegaron por tu página y esperan tu respuesta.</p>
                      <div class="mt-4" data-p-pendientes><div class="esqueleto h-28" /></div>
                    </section>
                  </div>
                  <section class="tarjeta p-5 sm:p-6" aria-labelledby="t-hoy">
                    <h2 id="t-hoy" class="text-lg font-bold">Hoy</h2>
                    <p class="mt-1 text-sm text-suave">Tu día, en orden.</p>
                    <div class="mt-4" data-p-hoy><div class="esqueleto h-40" /></div>
                  </section>
                </div>
              </section>

              <!-- Agenda -->
              <section data-seccion="agenda" aria-labelledby="t-agenda" hidden>
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <h1 id="t-agenda" class="text-2xl font-bold tracking-tight sm:text-3xl">Agenda</h1>
                  <div class="p-segmento" role="group" aria-label="Vista">
                    <button type="button" data-vista="dia" aria-pressed="true">Día</button>
                    <button type="button" data-vista="semana" aria-pressed="false">Semana</button>
                  </div>
                </div>
                <div class="tarjeta mt-5 flex flex-wrap items-center gap-3 p-3 sm:p-4">
                  <div class="flex items-center gap-1">
                    <button type="button" class="p-icono-btn" data-nav="-1" aria-label="Anterior"><Fragment set:html={icono('izq')} /></button>
                    <button type="button" class="btn btn-secundario min-h-10 px-4 text-sm" data-nav="0">Hoy</button>
                    <button type="button" class="p-icono-btn" data-nav="1" aria-label="Siguiente"><Fragment set:html={icono('der')} /></button>
                  </div>
                  <p class="min-w-0 flex-1 font-bold first-letter:uppercase" data-p-rango aria-live="polite" />
                  <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por estado">
                    <button type="button" class="chip" data-filtro="todas" aria-pressed="true">Todas</button>
                    <button type="button" class="chip" data-filtro="pendiente" aria-pressed="false">Por confirmar</button>
                    <button type="button" class="chip" data-filtro="confirmada" aria-pressed="false">Confirmadas</button>
                    <button type="button" class="chip" data-filtro="cancelada" aria-pressed="false">Canceladas</button>
                  </div>
                </div>
                <div class="mt-5" data-p-agenda />
              </section>

              <!-- Bloqueos -->
              <section data-seccion="bloqueos" aria-labelledby="t-bloqueos" hidden>
                <h1 id="t-bloqueos" class="text-2xl font-bold tracking-tight sm:text-3xl">Bloqueos</h1>
                <p class="mt-1 text-suave">Cierra días u horas (vacaciones, juntas, días festivos). Nadie podrá reservar en ese tiempo.</p>
                <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
                  <form id="form-bloqueo" class="tarjeta grid content-start gap-4 p-5 sm:p-6" novalidate>
                    <h2 class="text-lg font-bold">Nuevo bloqueo</h2>
                    <div class="grid grid-cols-2 gap-3">
                      <label class="campo"><span>Desde</span><input type="date" name="desde" required /></label>
                      <label class="campo"><span>Hasta</span><input type="date" name="hasta" /></label>
                    </div>
                    <label class="flex cursor-pointer items-center justify-between gap-3 rounded-xl bg-fondo px-4 py-3">
                      <span class="text-sm font-semibold">Todo el día</span>
                      <input type="checkbox" name="todo_dia" class="p-switch" checked />
                    </label>
                    <div class="grid grid-cols-2 gap-3" data-horas hidden>
                      <label class="campo"><span>De</span><input type="time" name="hora_desde" value="10:00" step="900" /></label>
                      <label class="campo"><span>A</span><input type="time" name="hora_hasta" value="14:00" step="900" /></label>
                    </div>
                    <label class="campo"><span>Motivo <span class="inline font-normal text-tenue">(opcional)</span></span><input name="motivo" maxlength="120" placeholder="Vacaciones, junta…" /></label>
                    <p id="bloqueo-error" class="text-sm font-medium text-peligro" role="alert" hidden />
                    <button type="submit" class="btn btn-primario w-full"><Fragment set:html={icono('mas', 18)} />Bloquear</button>
                  </form>
                  <section class="tarjeta p-5 sm:p-6" aria-labelledby="t-proximos-bloqueos">
                    <h2 id="t-proximos-bloqueos" class="text-lg font-bold">Próximos bloqueos</h2>
                    <div class="mt-4" data-p-bloqueos><div class="esqueleto h-20" /></div>
                  </section>
                </div>
              </section>

              <!-- Mi página -->
              <section data-seccion="pagina" aria-labelledby="t-pagina" hidden>
                <h1 id="t-pagina" class="text-2xl font-bold tracking-tight sm:text-3xl">Mi página</h1>
                <p class="mt-1 text-suave">Tu enlace de reservas, tus servicios y tu horario.</p>
                <div class="p-hero mt-6 p-6 sm:p-8">
                  <p class="text-sm font-semibold text-white/80">Tu página de reservas</p>
                  <p class="mt-2 break-all text-xl font-bold text-white sm:text-2xl" data-p-enlace>…</p>
                  <p class="mt-2 max-w-xl text-sm text-white/75">Compártelo en tu Instagram, tu perfil de Google y tu WhatsApp Business. Tus clientes eligen servicio, día y hora, y tú recibes el aviso aquí.</p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    <button type="button" class="btn bg-white text-marca-osc hover:bg-marca-50" data-p-copiar><Fragment set:html={icono('copiar', 18)} /><span>Copiar enlace</span></button>
                    <a class="btn border border-white/30 text-white hover:bg-white/10" data-p-abrir target="_blank" rel="noopener"><Fragment set:html={icono('abrir', 18)} />Abrir</a>
                    <button type="button" class="btn border border-white/30 text-white hover:bg-white/10" data-p-compartir><Fragment set:html={icono('compartir', 18)} />Compartir</button>
                  </div>
                </div>
                <div class="mt-6 grid gap-6 lg:grid-cols-2">
                  <section class="tarjeta p-5 sm:p-6" aria-labelledby="t-servicios">
                    <h2 id="t-servicios" class="text-lg font-bold">Servicios</h2>
                    <p class="mt-1 text-sm text-suave">Apaga un servicio para ocultarlo de tu página.</p>
                    <div class="mt-4" data-p-servicios><div class="esqueleto h-40" /></div>
                  </section>
                  <section class="tarjeta p-5 sm:p-6" aria-labelledby="t-horario">
                    <h2 id="t-horario" class="text-lg font-bold">Horario de atención</h2>
                    <p class="mt-1 text-sm text-suave">Las citas sólo se ofrecen dentro de este horario.</p>
                    <div class="mt-4" data-p-horario><div class="esqueleto h-40" /></div>
                  </section>
                </div>
              </section>
            </div>
          </main>

          <!-- Pestañas (móvil) -->
          <nav class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-4 border-t border-borde bg-superficie/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden" aria-label="Secciones">
            {
              secciones.map((s) => (
                <a href={`#${s.id}`} class="p-tab" data-ir={s.id}>
                  <span class="relative">
                    <Fragment set:html={icono(s.icono, 22)} />
                    {s.id === 'inicio' && <span class="p-contador absolute -right-2.5 -top-1.5" data-p-contador hidden />}
                  </span>
                  {s.nombre}
                </a>
              ))
            }
          </nav>
        </div>

        <dialog id="detalle" class="p-dialogo" aria-label="Detalle de la cita">
          <div data-p-detalle />
        </dialog>
        <div id="toasts" class="pointer-events-none fixed inset-x-0 bottom-24 z-50 grid justify-items-center gap-2 px-4 lg:bottom-6 lg:left-auto lg:right-6 lg:justify-items-end" aria-live="polite" />
      </div>
    )
  }

  <script>
    import '../scripts/panel';
  </script>

  <style is:global>
    .p-avatar {
      display: grid; place-items: center; flex-shrink: 0; border-radius: 0.9rem; font-weight: 700; color: #fff;
      background: linear-gradient(135deg, var(--color-marca), #8b5cf6); box-shadow: 0 6px 16px -8px rgb(79 70 229 / 0.8);
    }
    .p-nav {
      display: flex; align-items: center; gap: 0.75rem; border-radius: 0.8rem; padding: 0.65rem 0.75rem;
      font-size: 0.95rem; font-weight: 600; color: var(--color-suave); transition: background-color 0.15s, color 0.15s;
    }
    .p-nav:hover { background: var(--color-fondo); color: var(--color-texto); }
    .p-nav[aria-current='page'] { background: var(--color-marca-50); color: var(--color-marca-osc); }
    .p-tab {
      display: grid; justify-items: center; gap: 0.2rem; padding: 0.55rem 0 0.5rem; font-size: 0.7rem; font-weight: 600; color: var(--color-tenue);
    }
    .p-tab[aria-current='page'] { color: var(--color-marca); }
    .p-contador {
      display: inline-grid; place-items: center; min-width: 1.3rem; height: 1.3rem; padding: 0 0.35rem; border-radius: 999px;
      background: #f59e0b; color: #fff; font-size: 0.7rem; font-weight: 800; font-variant-numeric: tabular-nums;
    }
    .p-contador[hidden] { display: none; }
    .p-icono-btn {
      display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 0.8rem; color: var(--color-suave);
      transition: background-color 0.15s, color 0.15s;
    }
    .p-icono-btn:hover { background: var(--color-fondo); color: var(--color-texto); }
    .p-icono-btn[aria-pressed='true'] { color: var(--color-marca); }
    .p-vivo { display: inline-block; width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--color-tenue); flex-shrink: 0; }
    .p-vivo[data-ok='si'] { background: #10b981; box-shadow: 0 0 0 3px rgb(16 185 129 / 0.18); }
    .p-vivo[data-ok='no'] { background: #f59e0b; }
    .p-segmento { display: inline-flex; padding: 0.25rem; border-radius: 0.9rem; background: #e9ebf2; }
    .p-segmento button { min-height: 2.4rem; padding: 0 1.1rem; border-radius: 0.7rem; font-size: 0.9rem; font-weight: 600; color: var(--color-suave); }
    .p-segmento button[aria-pressed='true'] { background: var(--color-superficie); color: var(--color-texto); box-shadow: 0 1px 3px rgb(16 24 40 / 0.12); }

    .p-kpi { display: grid; gap: 0.75rem; padding: 1rem 1.1rem; }
    .p-kpi-icono { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 0.8rem; }

    .p-hero {
      position: relative; overflow: hidden; border-radius: var(--radius-tarjeta);
      background: radial-gradient(120% 140% at 100% 0%, #7c3aed 0%, transparent 55%), linear-gradient(135deg, #4338ca, #4f46e5 60%, #6366f1);
      box-shadow: 0 18px 40px -20px rgb(67 56 202 / 0.75);
    }
    .p-hero::after {
      content: ''; position: absolute; right: -3rem; bottom: -4rem; width: 14rem; height: 14rem; border-radius: 999px;
      border: 2.5rem solid rgb(255 255 255 / 0.07); pointer-events: none;
    }

    .p-cita {
      position: relative; display: grid; gap: 0.75rem; border-radius: 1rem; border: 1px solid var(--color-borde);
      background: var(--color-superficie); padding: 1rem 1rem 1rem 1.25rem; overflow: hidden;
    }
    .p-cita::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--color-tenue); }
    .p-cita[data-estado='pendiente']::before { background: #f59e0b; }
    .p-cita[data-estado='confirmada']::before { background: #10b981; }
    .p-cita[data-estado='cancelada'] { background: #fafbfc; }
    .p-cita[data-estado='cancelada'] .p-cita-titulo { color: var(--color-suave); text-decoration: line-through; text-decoration-color: #c3c9d4; }
    .p-accion {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 2.5rem; padding: 0 0.95rem;
      border-radius: 0.75rem; font-size: 0.875rem; font-weight: 700; border: 1px solid var(--color-borde); background: var(--color-superficie);
      color: var(--color-texto); transition: all 0.15s;
    }
    .p-accion:hover { border-color: #c7cce0; background: var(--color-fondo); }
    .p-accion:disabled { opacity: 0.55; cursor: wait; }
    .p-accion[data-tipo='confirmar'] { background: var(--color-confirmada); border-color: var(--color-confirmada); color: #fff; }
    .p-accion[data-tipo='confirmar']:hover { filter: brightness(1.08); }
    .p-accion[data-tipo='wa'] { color: #128c4b; }
    .p-accion[data-tipo='cancelar']:hover { color: var(--color-peligro); border-color: #fed7aa; background: #fff7ed; }

    .p-linea { position: relative; display: grid; grid-template-columns: 3.4rem minmax(0, 1fr); gap: 0.75rem; }
    .p-linea + .p-linea { margin-top: 0.75rem; }
    @media (max-width: 639px) { .p-linea { grid-template-columns: minmax(0, 1fr); } .p-linea-hora { display: none; } }
    .p-linea-hora { padding-top: 1rem; text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--color-texto); font-size: 0.95rem; }
    .p-linea-hora small { display: block; font-weight: 500; color: var(--color-tenue); font-size: 0.75rem; }

    .p-semana { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.6rem; }
    .p-dia-col { display: grid; align-content: start; gap: 0.45rem; min-height: 20rem; border-radius: 1rem; background: var(--color-superficie); border: 1px solid var(--color-borde); padding: 0.6rem; }
    .p-dia-col[data-hoy] { border-color: var(--color-marca); box-shadow: 0 0 0 3px var(--color-marca-50); }
    .p-bloque {
      display: grid; gap: 0.1rem; width: 100%; text-align: left; border-radius: 0.65rem; padding: 0.45rem 0.55rem; font-size: 0.78rem;
      border-left: 3px solid var(--color-tenue); background: var(--color-cancelada-50); transition: transform 0.15s, box-shadow 0.15s;
    }
    .p-bloque:hover { transform: translateY(-1px); box-shadow: 0 6px 14px -8px rgb(16 24 40 / 0.35); }
    .p-bloque[data-estado='pendiente'] { background: var(--color-pendiente-50); border-color: #f59e0b; }
    .p-bloque[data-estado='confirmada'] { background: var(--color-confirmada-50); border-color: #10b981; }
    .p-bloque[data-estado='cancelada'] { opacity: 0.6; text-decoration: line-through; }

    .p-switch {
      appearance: none; position: relative; width: 2.75rem; height: 1.6rem; border-radius: 999px; background: #d4d8e3; cursor: pointer;
      transition: background-color 0.2s; flex-shrink: 0;
    }
    .p-switch::after {
      content: ''; position: absolute; top: 0.2rem; left: 0.2rem; width: 1.2rem; height: 1.2rem; border-radius: 999px; background: #fff;
      box-shadow: 0 1px 3px rgb(16 24 40 / 0.25); transition: transform 0.2s;
    }
    .p-switch:checked { background: var(--color-marca); }
    .p-switch:checked::after { transform: translateX(1.15rem); }
    .p-switch:disabled { opacity: 0.5; cursor: wait; }

    .p-dialogo {
      margin: auto; width: min(30rem, calc(100% - 2rem)); border-radius: var(--radius-tarjeta); border: 0; padding: 0;
      background: transparent; box-shadow: var(--shadow-flota);
    }
    .p-dialogo::backdrop { background: rgb(16 24 40 / 0.45); backdrop-filter: blur(2px); }
    .p-toast {
      pointer-events: auto; display: flex; align-items: center; gap: 0.6rem; max-width: 26rem; border-radius: 0.9rem; padding: 0.8rem 1rem;
