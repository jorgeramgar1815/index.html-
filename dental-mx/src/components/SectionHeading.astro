---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  class?: string;
  as?: 'h1' | 'h2';
}
const { eyebrow, title, intro, align = 'left', class: className = '', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <p class:list={['eyebrow mb-4', align === 'center' && 'justify-center']} data-reveal>{eyebrow}</p>}
  <Tag class="text-3xl leading-[1.08] font-bold sm:text-4xl lg:text-[3.25rem]" data-split set:html={title} />
  {intro && <p class="mt-5 text-lg leading-relaxed text-mute [.on-light_&]:text-slate" data-reveal style="--i:2">{intro}</p>}
  <div data-reveal style="--i:3"><slot /></div>
</div>
