---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  class?: string;
  as?: 'h1' | 'h2';
}
const { eyebrow, title, intro, align = 'left', class: className = '', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]} data-reveal>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <Tag class="text-3xl leading-[1.1] font-bold sm:text-4xl lg:text-5xl" set:html={title} />
  {intro && <p class="mt-5 text-lg leading-relaxed text-mute [.on-light_&]:text-slate">{intro}</p>}
  <slot />
</div>
