---
/**
 * Ilustración de sonrisa (antes/después) generada por código.
 * Sólo ilustrativa: reemplazar por fotografías de casos reales autorizados.
 */
interface Props {
  variant: 'whitening' | 'ortho' | 'restoration';
  state: 'before' | 'after';
  class?: string;
}
const { variant, state, class: className = '' } = Astro.props;
const uid = `sm-${Math.random().toString(36).slice(2, 8)}`;
const before = state === 'before';

// Dientes superiores (izq → der): ancho, alto
const upper = [
  [26, 44], [30, 54], [34, 52], [40, 62], [40, 62], [34, 52], [30, 54], [26, 44],
];
const lower = [24, 26, 27, 29, 29, 27, 26, 24];
const gap = 3;
const total = upper.reduce((a, [w]) => a + w, 0) + gap * (upper.length - 1);

// Desalineación para ortodoncia (rotación°, desplazamiento y)
const orthoOffset = [
  [6, 4], [-10, -5], [13, 8], [-6, 3], [8, -4], [-12, 6], [5, -3], [-7, 5],
];

let x = 200 - total / 2;
const teeth = upper.map(([w, h], i) => {
  const cx = x + w / 2;
  x += w + gap;
  const dx = cx - 200;
  const bottom = 142 - dx * dx * 0.00062;
  let rot = 0;
  let dy = 0;
  if (variant === 'ortho' && before) [rot, dy] = orthoOffset[i];
  return { cx, w, h, bottom: bottom + dy, rot, i };
});

let lx = 200 - (lower.reduce((a, w) => a + w, 0) + gap * 7) / 2;
const lowerTeeth = lower.map((w) => {
  const cx = lx + w / 2;
  lx += w + gap;
  const dx = cx - 200;
  const top = 140 - dx * dx * 0.00062;
  return { cx, w, top };
});

const enamel = variant === 'whitening' && before ? `url(#${uid}-yellow)` : variant === 'ortho' && before ? `url(#${uid}-ivory)` : `url(#${uid}-white)`;
const missing = variant === 'restoration' && before ? 2 : -1;
const chipped = variant === 'restoration' && before ? 3 : -1;

const toothPath = (w: number, h: number) => {
  const r = Math.min(14, w / 2.4);
  return `M${-w / 2} ${-h}h${w}v${h - r}q0 ${r} ${-r} ${r}h${-(w - 2 * r)}q${-r} 0 ${-r} ${-r}Z`;
};
const chipPath = (w: number, h: number) => {
  const r = Math.min(10, w / 3);
  return `M${-w / 2} ${-h}h${w}v${h - 14}l${-10} 8l-6 6h${-(w - 16 - r)}q${-r} 0 ${-r} ${-r}Z`;
};
---

<svg viewBox="0 0 400 240" class={className} aria-hidden="true">
  <defs>
    <linearGradient id={`${uid}-white`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e9ece4" />
      <stop offset=".55" stop-color="#fbfcf8" />
      <stop offset="1" stop-color="#eef1e8" />
    </linearGradient>
    <linearGradient id={`${uid}-ivory`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ddd6c2" />
      <stop offset="1" stop-color="#f1ecdd" />
    </linearGradient>
    <linearGradient id={`${uid}-yellow`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b9a067" />
      <stop offset=".6" stop-color="#d8c28c" />
      <stop offset="1" stop-color="#cdb57c" />
    </linearGradient>
    <radialGradient id={`${uid}-mouth`} cx=".5" cy=".45" r=".6">
      <stop offset="0" stop-color="#3a1a1f" />
      <stop offset="1" stop-color="#1a0b0e" />
    </radialGradient>
    <clipPath id={`${uid}-clip`}>
      <path d="M34 104C120 60 280 60 366 104 300 212 100 212 34 104Z" />
    </clipPath>
    <filter id={`${uid}-glow`} x="-10%" y="-20%" width="120%" height="140%">
      <feGaussianBlur stdDeviation="3" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>

  <rect width="400" height="240" fill="#121412" />
  <g clip-path={`url(#${uid}-clip)`}>
    <rect width="400" height="240" fill={`url(#${uid}-mouth)`} />
    <!-- inferiores -->
    {lowerTeeth.map((t) => <rect x={t.cx - t.w / 2} y={t.top} width={t.w} height="40" rx="8" fill={enamel} opacity=".82" />)}
    <!-- superiores -->
    {
      teeth.map((t) =>
        t.i === missing ? null : (
          <g transform={`translate(${t.cx} ${t.bottom}) rotate(${t.rot})`}>
            <path d={t.i === chipped ? chipPath(t.w, t.h + 30) : toothPath(t.w, t.h + 30)} fill={enamel} />
            <path d={`M${-t.w / 2 + 5} ${-t.h + 6}v${t.h - 18}`} stroke="#fff" stroke-opacity=".55" stroke-width="3" stroke-linecap="round" />
          </g>
        ),
      )
    }
    <!-- encía superior (sobre la raíz de los dientes) -->
    <path d="M30 30H370V98C300 68 100 68 30 98Z" fill="#7a3a44" />
    {variant === 'restoration' && before && <circle cx={teeth[1].cx + 2} cy={teeth[1].bottom - 18} r="5" fill="#4a3a26" opacity=".85" />}
  </g>
  <!-- labios en neón -->
  <path d="M34 104C120 60 280 60 366 104 300 212 100 212 34 104Z" fill="none" stroke="#b5ee3a" stroke-width="3" filter={`url(#${uid}-glow)`} />
</svg>
