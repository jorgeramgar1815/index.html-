---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, services, site, waLink } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-line bg-ink-2 pt-16 pb-28 sm:pb-12">
  <!-- Marca de agua -->
  <svg viewBox="0 0 24 24" class="pointer-events-none absolute -right-16 -bottom-24 size-96 text-white/[0.025]" fill="none" stroke="currentColor" stroke-width=".6" aria-hidden="true">
    <path d="M7.5 3C4.9 3 3.5 5 3.5 7.8c0 2.6 1 4.6 1.7 7.3.6 2.5 1 5.4 2.4 5.4 1.3 0 1.6-2.6 2.2-4.6.4-1.3 1.2-2.1 2.2-2.1s1.8.8 2.2 2.1c.6 2 .9 4.6 2.2 4.6 1.4 0 1.8-2.9 2.4-5.4.7-2.7 1.7-4.7 1.7-7.3C20.5 5 19.1 3 16.5 3c-1.9 0-3 1-4.5 1S9.4 3 7.5 3Z" />
  </svg>

  <div class="container-x relative">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo />
        <p class="mt-5 max-w-xs text-mute">{site.description} {site.tagline}.</p>
        <p class="mt-6 font-display text-xs font-semibold tracking-[0.18em] text-snow/60 uppercase">
          {site.values.join(' · ')}
        </p>
        <div class="mt-6 flex gap-3">
          <a href={site.social.instagram.url} target="_blank" rel="noopener" class="grid size-11 place-items-center rounded-full border border-line text-snow transition-colors hover:border-lime hover:text-lime" aria-label={`Instagram ${site.social.instagram.handle}`}>
            <Icon name="instagram" size={20} />
          </a>
          <a href={site.social.facebook.url} target="_blank" rel="noopener" class="grid size-11 place-items-center rounded-full border border-line text-snow transition-colors hover:border-lime hover:text-lime" aria-label="Facebook Dental MX">
            <Icon name="facebook" size={20} />
          </a>
          <a href={waLink()} target="_blank" rel="noopener" class="grid size-11 place-items-center rounded-full border border-line text-snow transition-colors hover:border-lime hover:text-lime" aria-label="WhatsApp Dental MX">
            <Icon name="whatsapp" size={19} />
          </a>
        </div>
      </div>

      <nav aria-label="Enlaces rápidos" class="lg:col-span-2">
        <h2 class="font-display text-sm font-semibold text-white">Sitio</h2>
        <ul class="mt-4 space-y-3">
          {nav.map((item) => <li><a href={item.href} class="text-mute transition-colors hover:text-lime">{item.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Servicios" class="lg:col-span-3">
        <h2 class="font-display text-sm font-semibold text-white">Servicios</h2>
        <ul class="mt-4 space-y-3">
          {services.map((s) => <li><a href={`/servicios/#${s.slug}`} class="text-mute transition-colors hover:text-lime">{s.name}</a></li>)}
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <h2 class="font-display text-sm font-semibold text-white">Visítanos</h2>
        <address class="mt-4 space-y-4 text-mute not-italic">
          <p class="flex gap-3"><Icon name="pin" size={20} class="mt-0.5 shrink-0 text-lime" /><span>{site.address.street}<br />{site.address.neighborhood}, {site.address.postalCode}<br />{site.address.city}, {site.address.region}</span></p>
          <p class="flex gap-3"><Icon name="phone" size={20} class="mt-0.5 shrink-0 text-lime" /><a href={`tel:${site.phone.tel}`} class="transition-colors hover:text-lime">{site.phone.display}</a></p>
          <p class="flex gap-3"><Icon name="instagram" size={20} class="mt-0.5 shrink-0 text-lime" /><a href={site.social.instagram.url} target="_blank" rel="noopener" class="transition-colors hover:text-lime">{site.social.instagram.handle}</a></p>
        </address>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-line pt-8 text-sm text-mute sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="/aviso-de-privacidad/" class="transition-colors hover:text-lime">Aviso de privacidad</a>
        <a href="/contacto/" class="transition-colors hover:text-lime">Contacto</a>
      </div>
    </div>
  </div>
</footer>
