---
/** Tarjeta de servicio (bento): qué es, para quién, promo y consulta directa por WhatsApp. */
import Icon from './Icon.astro';
import { flags, waLink, type Service } from '../data/site';
interface Props {
  service: Service;
  index?: number;
  /** 'wide' ocupa 2 columnas; 'full' ocupa toda la fila en horizontal. */
  size?: 'normal' | 'wide' | 'full';
}
const { service, index = 0, size = 'normal' } = Astro.props;
const big = size !== 'normal';
---

<article
  id={service.slug}
  class:list={[
    'card card-hover group relative flex h-full scroll-mt-28 flex-col overflow-hidden p-6 sm:p-8',
    size === 'wide' && 'md:col-span-2',
    size === 'full' && 'md:col-span-2 lg:col-span-3 lg:flex-row lg:items-center lg:gap-10',
  ]}
  data-reveal
  data-tilt
  style={`--i:${index % 3}`}
>
  {
    big && (
      <div class="pointer-events-none absolute -right-8 -bottom-10 text-lime/[0.09] transition-[color,translate] duration-700 group-hover:-translate-y-2 group-hover:text-lime/25" aria-hidden="true">
        <Icon name={service.icon} size={size === 'full' ? 220 : 260} strokeWidth={0.6} />
      </div>
    )
  }

  <div class:list={['relative flex items-start justify-between gap-4', size === 'full' && 'lg:flex-col lg:justify-center']}>
    <span class:list={['icon-tube', big && 'size-14']}><Icon name={service.icon} size={big ? 30 : 26} /></span>
    {
      flags.showPrices && service.promo && (
        /* PLACEHOLDER: precio promocional por confirmar con el cliente */
        <p class="inline-flex items-baseline gap-2 rounded-full bg-lime px-3.5 py-1.5 text-sm font-semibold text-ink shadow-[var(--shadow-glow-sm)]">
          {service.promo.was && <s class="font-normal opacity-60">{service.promo.was}</s>}
          <strong class="font-display">{service.promo.now}</strong>
        </p>
      )
    }
  </div>

  <div class="relative mt-6 flex flex-1 flex-col lg:mt-6">
    <h3 class:list={['font-bold text-white', big ? 'text-2xl sm:text-3xl' : 'text-xl']}>{service.name}</h3>
    <p class:list={['mt-2 leading-relaxed text-mute', big && 'max-w-md sm:text-lg']}>{service.short}</p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Ideal para">
      {service.forWho.map((f) => <li class="rounded-full border border-line bg-white/[0.03] px-3 py-1 text-xs font-medium text-snow/80">{f}</li>)}
    </ul>
  </div>

  <a
    href={waLink(service.waMessage)}
    target="_blank"
    rel="noopener"
    class:list={[
      'relative mt-7 inline-flex min-h-11 w-fit items-center gap-2 rounded-full border border-lime/35 px-4 font-display text-sm font-semibold text-lime transition-[background-color,color,box-shadow] duration-300 hover:bg-lime hover:text-ink hover:shadow-[var(--shadow-glow-sm)]',
      size === 'full' && 'lg:mt-0 lg:shrink-0',
    ]}
    data-cta={`service-${service.slug}`}
  >
    <Icon name="whatsapp" size={17} />
    Preguntar
    <Icon name="arrow-right" size={15} class="transition-transform duration-300 group-hover:translate-x-1" />
    <span class="sr-only">por {service.name.toLowerCase()} (se abre WhatsApp en una pestaña nueva)</span>
  </a>
</article>
