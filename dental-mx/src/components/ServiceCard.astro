---
/** Tarjeta de servicio de la landing: qué es, para quién es y consulta directa por WhatsApp. */
import Icon from './Icon.astro';
import { flags, waLink, type Service } from '../data/site';
interface Props { service: Service; index?: number }
const { service, index = 0 } = Astro.props;
---

<article
  id={service.slug}
  class="card card-hover group flex h-full scroll-mt-28 flex-col p-6 sm:p-7"
  data-reveal
  style={`--i:${index % 3}`}
>
  <div class="flex items-start justify-between gap-4">
    <span class="icon-tube"><Icon name={service.icon} size={26} /></span>
    {
      flags.showPrices && service.promo ? (
        /* PLACEHOLDER: precio promocional por confirmar con el cliente */
        <p class="inline-flex items-baseline gap-2 rounded-full border border-lime/30 bg-lime/10 px-3 py-1 text-sm">
          {service.promo.was && <s class="text-mute">{service.promo.was}</s>}
          <strong class="font-display text-lime">{service.promo.now}</strong>
        </p>
      ) : (
        <span class="font-display text-sm font-semibold text-white/25 tabular-nums" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
      )
    }
  </div>
  <h3 class="mt-6 text-xl font-bold text-white">{service.name}</h3>
  <p class="mt-3 leading-relaxed text-mute">{service.short}</p>

  <p class="mt-5 font-display text-xs font-semibold tracking-[0.14em] text-snow/60 uppercase">Ideal si…</p>
  <ul class="mt-3 flex-1 space-y-2">
    {
      service.forWho.map((f) => (
        <li class="flex gap-2.5 text-[0.95rem] leading-snug text-snow/85">
          <Icon name="check" size={17} strokeWidth={2.2} class="mt-0.5 shrink-0 text-lime" />
          <span>{f}</span>
        </li>
      ))
    }
  </ul>

  <a
    href={waLink(service.waMessage)}
    target="_blank"
    rel="noopener"
    class="mt-7 inline-flex min-h-11 w-fit items-center gap-2 rounded-full border border-lime/35 px-4 font-display text-sm font-semibold text-lime transition-[background-color,color,box-shadow] duration-300 hover:bg-lime hover:text-ink hover:shadow-[var(--shadow-glow-sm)]"
    data-cta={`service-${service.slug}`}
  >
    <Icon name="whatsapp" size={17} />
    Preguntar por {service.name.toLowerCase()}
    <span class="sr-only">(se abre WhatsApp en una pestaña nueva)</span>
  </a>
</article>
