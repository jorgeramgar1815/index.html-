---
import Icon from './Icon.astro';
import { flags, type Service } from '../data/site';
interface Props { service: Service; index?: number }
const { service, index = 0 } = Astro.props;
---

<a
  href={`/servicios/#${service.slug}`}
  class="card card-hover group flex h-full flex-col p-6 sm:p-7"
  data-reveal
  style={`--i:${index % 3}`}
>
  <div class="flex items-start justify-between gap-4">
    <span class="icon-tube"><Icon name={service.icon} size={26} /></span>
    <span class="font-display text-sm font-semibold text-white/25 tabular-nums" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  </div>
  <h3 class="mt-6 text-xl font-bold text-white">{service.name}</h3>
  <p class="mt-3 flex-1 leading-relaxed text-mute">{service.short}</p>
  {
    flags.showPrices && service.promo && (
      /* PLACEHOLDER: precio promocional por confirmar con el cliente */
      <p class="mt-5 inline-flex w-fit items-baseline gap-2 rounded-full border border-lime/30 bg-lime/10 px-3 py-1 text-sm">
        <span class="text-snow/80">{service.promo.label}</span>
        {service.promo.was && <s class="text-mute">{service.promo.was}</s>}
        <strong class="font-display text-lime">{service.promo.now}</strong>
      </p>
    )
  }
  <span class="mt-6 inline-flex items-center gap-2 font-display text-sm font-semibold text-lime">
    Ver detalle
    <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
  </span>
</a>
