---
/** Panel visual de servicio: ícono en "tubo de neón" sobre muro oscuro. Si hay foto, la usa. */
import Icon from './Icon.astro';
import type { Service } from '../data/site';
interface Props { service: Service; index: number; class?: string }
const { service, index, class: className = '' } = Astro.props;
---

<div class:list={['grain group relative aspect-[4/3] overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface', className]}>
  {
    service.image ? (
      <img src={service.image} alt={`${service.name} en Dental MX`} loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
    ) : (
      <>
        <div class="absolute inset-0 wood-slats opacity-70" aria-hidden="true" />
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,rgb(181_238_58/0.22),transparent_55%)]" aria-hidden="true" />
        <div class="absolute inset-0 grid place-items-center" aria-hidden="true">
          <span class="relative text-white transition-transform duration-700 ease-out group-hover:scale-105">
            <Icon name={service.icon} size={150} strokeWidth={0.9} class="absolute inset-0 text-lime opacity-60 blur-[6px]" />
            <Icon name={service.icon} size={150} strokeWidth={0.7} class="relative drop-shadow-[0_0_8px_rgb(181_238_58/0.8)]" />
          </span>
        </div>
      </>
    )
  }
  <span class="absolute top-5 left-5 font-display text-5xl font-extrabold text-white/10 sm:text-6xl" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
</div>
