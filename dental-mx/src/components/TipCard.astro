---
/** Tarjeta educativa estilo carrusel de Facebook: fondo negro, texto grande, sello del diente. */
import Icon from './Icon.astro';
interface Props { tip: { tag: string; title: string; points: string[] }; index?: number }
const { tip, index = 0 } = Astro.props;
---

<article class="card card-hover relative flex h-full flex-col overflow-hidden p-7 sm:p-8" data-reveal style={`--i:${index}`}>
  <!-- Sello / marca de agua del diente -->
  <svg viewBox="0 0 24 24" class="pointer-events-none absolute -top-4 -right-4 size-28 text-lime/[0.07]" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
    <path d="M7.5 3C4.9 3 3.5 5 3.5 7.8c0 2.6 1 4.6 1.7 7.3.6 2.5 1 5.4 2.4 5.4 1.3 0 1.6-2.6 2.2-4.6.4-1.3 1.2-2.1 2.2-2.1s1.8.8 2.2 2.1c.6 2 .9 4.6 2.2 4.6 1.4 0 1.8-2.9 2.4-5.4.7-2.7 1.7-4.7 1.7-7.3C20.5 5 19.1 3 16.5 3c-1.9 0-3 1-4.5 1S9.4 3 7.5 3Z" />
  </svg>
  <p class="text-xs font-semibold tracking-[0.18em] text-lime uppercase">Tip · {tip.tag}</p>
  <h3 class="mt-3 text-2xl font-bold text-white">{tip.title}</h3>
  <ul class="mt-6 space-y-4">
    {
      tip.points.map((p) => (
        <li class="flex gap-3 leading-relaxed text-snow/85">
          <Icon name="check" size={20} class="mt-0.5 shrink-0 text-lime" strokeWidth={2} />
          <span>{p}</span>
        </li>
      ))
    }
  </ul>
</article>
