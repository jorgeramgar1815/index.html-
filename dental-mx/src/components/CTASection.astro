---
import WhatsAppButton from './WhatsAppButton.astro';
import NeonTooth from './NeonTooth.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  text?: string;
  message?: string;
  cta?: string;
}
const {
  title = 'Tu próxima sonrisa empieza con un mensaje',
  text = 'Escríbenos por WhatsApp, cuéntanos qué necesitas y te damos una cita a tu medida.',
  message,
  cta = 'cta-section',
} = Astro.props;
---

<section class="section relative">
  <div class="container-x">
    <div class="grain relative overflow-hidden rounded-[2rem] border border-lime/20 bg-surface px-6 py-14 sm:px-12 sm:py-20 lg:px-20" data-reveal>
      <div class="pointer-events-none absolute -top-40 -right-24 size-[28rem] rounded-full bg-lime/20 blur-[120px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 grid-fade opacity-60" aria-hidden="true"></div>
      <div class="relative grid grid-cols-1 items-center gap-10 lg:grid-cols-[1fr_auto]">
        <div class="max-w-2xl">
          <h2 class="text-3xl leading-[1.1] font-bold sm:text-4xl lg:text-5xl" set:html={title} />
          <p class="mt-5 text-lg text-mute">{text}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <WhatsAppButton size="lg" message={message} cta={cta} />
            <a href={`tel:${site.phone.tel}`} class="btn btn-ghost btn-lg">Llamar al {site.phone.display}</a>
          </div>
        </div>
        <NeonTooth class="mx-auto hidden w-44 lg:block xl:w-52" />
      </div>
    </div>
  </div>
</section>
