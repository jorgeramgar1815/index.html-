---
import Icon from './Icon.astro';
import { waLink } from '../data/site';
---

<div id="fab" class="pointer-events-none fixed right-4 bottom-4 z-50 flex flex-col items-end gap-3 sm:right-6 sm:bottom-6" style="padding-bottom: env(safe-area-inset-bottom)">
  <button
    id="back-to-top"
    type="button"
    class="pointer-events-auto grid size-11 translate-y-2 place-items-center rounded-full border border-line bg-surface/90 text-snow opacity-0 backdrop-blur transition-[opacity,transform,color,border-color] duration-400 hover:border-lime hover:text-lime data-[show=true]:translate-y-0 data-[show=true]:opacity-100 invisible data-[show=true]:visible"
    aria-label="Volver arriba"
    data-show="false"
  >
    <Icon name="arrow-up" size={18} />
  </button>

  <a
    href={waLink()}
    target="_blank"
    rel="noopener"
    class="group pointer-events-auto relative flex items-center"
    aria-label="¿Agendamos tu cita? Escríbenos por WhatsApp (se abre en una pestaña nueva)"
    data-cta="fab-whatsapp"
  >
    <span
      class="mr-3 hidden translate-x-2 rounded-full border border-line bg-surface/95 px-4 py-2 text-sm font-medium whitespace-nowrap text-snow opacity-0 shadow-lg backdrop-blur transition-[opacity,transform] duration-300 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 lg:block"
      aria-hidden="true">¿Agendamos tu cita?</span
    >
    <span
      class="wa-pulse grid size-14 place-items-center rounded-full bg-lime text-ink shadow-[0_10px_30px_-8px_rgb(181_238_58/0.6)] transition-transform duration-300 group-hover:scale-105"
    >
      <Icon name="whatsapp" size={28} />
    </span>
  </a>
</div>
