---
/**
 * Foto con respaldo ilustrado.
 * - Si `src` tiene valor: muestra la foto real optimizada (lazy).
 * - Si está vacío: muestra una ilustración de marca (line-art neón sobre muro
 *   de madera) con etiqueta PLACEHOLDER, hasta recibir fotografía del cliente.
 *
 * Para reemplazar: coloca la imagen en /public/img/ y pasa `src="/img/archivo.jpg"`.
 */
import { flags } from '../data/site';

interface Props {
  src?: string;
  alt: string;
  scene?: 'chair' | 'reception' | 'lounge' | 'portrait';
  label?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, scene = 'chair', label = 'Foto del consultorio', class: className = '', eager = false } = Astro.props;
const uid = `ph-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['relative overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface', className]}>
  {
    src ? (
      <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" class="absolute inset-0 size-full object-cover" />
    ) : (
      <>
        <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 size-full" role="img" aria-label={`${alt} (ilustración provisional)`}>
          <defs>
            <pattern id={`${uid}-slats`} width="26" height="300" patternUnits="userSpaceOnUse">
              <rect width="26" height="300" fill="#3b2b1d" />
              <rect x="0" width="12" height="300" fill="#46331f" />
              <rect x="24" width="2" height="300" fill="#21180f" />
            </pattern>
            <linearGradient id={`${uid}-shade`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0e100e" stop-opacity=".15" />
              <stop offset=".75" stop-color="#0e100e" stop-opacity=".78" />
              <stop offset="1" stop-color="#0e100e" stop-opacity=".95" />
            </linearGradient>
            <radialGradient id={`${uid}-warm`} cx=".5" cy="0" r=".8">
              <stop offset="0" stop-color="#ffb870" stop-opacity=".55" />
              <stop offset="1" stop-color="#ffb870" stop-opacity="0" />
            </radialGradient>
            <radialGradient id={`${uid}-lime`} cx="1" cy="1" r=".7">
              <stop offset="0" stop-color="#b5ee3a" stop-opacity=".35" />
              <stop offset="1" stop-color="#b5ee3a" stop-opacity="0" />
            </radialGradient>
            <linearGradient id={`${uid}-cone`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fff3dc" stop-opacity=".45" />
              <stop offset="1" stop-color="#fff3dc" stop-opacity="0" />
            </linearGradient>
            <filter id={`${uid}-glow`} x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="2.4" result="b" />
              <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
          </defs>

          <rect width="400" height="300" fill={`url(#${uid}-slats)`} />
          <rect width="400" height="300" fill={`url(#${uid}-warm)`} />
          <rect width="400" height="300" fill={`url(#${uid}-shade)`} />
          <rect width="400" height="300" fill={`url(#${uid}-lime)`} />
          <!-- Luz de cortesía (cove) -->
          <rect x="0" y="0" width="400" height="3" fill="#ffd9a8" opacity=".7" />

          <g fill="none" stroke-linecap="round" stroke-linejoin="round" filter={`url(#${uid}-glow)`}>
            {scene === 'chair' && (
              <>
                <path d="M250 70 L140 250 H390 L300 70Z" fill={`url(#${uid}-cone)`} stroke="none" opacity=".35" />
                <path d="M330 0v38l-58 26" stroke="#e6e6e6" stroke-width="2" />
                <ellipse cx="258" cy="72" rx="24" ry="9" stroke="#fff" stroke-width="2.2" />
                <path d="M40 262H380" stroke="#fff" stroke-opacity=".18" stroke-width="1.5" />
                <path d="M150 262h110M205 262v-48" stroke="#fff" stroke-width="2.4" />
                <path d="M128 214h140c10 0 16-4 20-10l-4-8H132c-8 0-12 6-4 18Z" stroke="#fff" stroke-width="2.4" />
                <path d="M288 204l52 26c6 3 8 8 6 12l-2 3-58-28" stroke="#fff" stroke-width="2.4" />
                <path d="M132 196 94 126c-2-5 0-9 5-10l8-1c4 0 7 2 9 6l34 75" stroke="#fff" stroke-width="2.4" />
                <path d="M92 116c-4-7-2-14 5-16l9-2c6-1 10 2 11 7" stroke="#fff" stroke-width="2.2" />
                <path d="M170 184h52" stroke="#fff" stroke-width="2.2" />
                <path d="M350 262v-32h28v32M364 230c-10-16-24-22-30-40 14 4 24 14 30 30 2-20 10-34 24-44-2 20-8 34-20 50" stroke="#b5ee3a" stroke-width="2" />
              </>
            )}
            {scene === 'reception' && (
              <>
                <path d="M170 60c-9 0-14 7-14 16 0 9 4 15 6 24 2 8 3 17 8 17 4 0 5-8 7-14 1-4 4-7 7-7s6 3 7 7c2 6 3 14 7 14 5 0 6-9 8-17 2-9 6-15 6-24 0-9-5-16-14-16-6 0-9 3-14 3s-8-3-14-3Z" stroke="#fff" stroke-width="2.4" />
                <path d="M226 64c.6 4 2 5.4 6 6-4 .6-5.4 2-6 6-.6-4-2-5.4-6-6 4-.6 5.4-2 6-6Z" stroke="#b5ee3a" stroke-width="1.8" />
                <path d="M60 262V190h250v72M50 190h270" stroke="#fff" stroke-width="2.4" />
                <path d="M60 212h250" stroke="#fff" stroke-opacity=".35" stroke-width="1.5" />
                <path d="M30 262H390" stroke="#fff" stroke-opacity=".18" stroke-width="1.5" />
                <path d="M345 262v-40h30v40M360 222c-2-24-16-36-26-52 16 6 26 22 28 38 4-26 14-40 28-50-4 22-12 40-26 60" stroke="#b5ee3a" stroke-width="2" />
                <path d="M110 190v-16h34v16M250 190c0-12 8-18 18-18" stroke="#fff" stroke-width="2" />
              </>
            )}
            {scene === 'lounge' && (
              <>
                <path d="M60 250v-50c0-10 6-14 14-14h176c8 0 14 4 14 14v50M48 214c0-8 6-12 12-12s12 4 12 12v36H48ZM252 214c0-8 6-12 12-12s12 4 12 12v36h-24Z" stroke="#fff" stroke-width="2.4" />
                <path d="M72 230h180M70 250v12M254 250v12" stroke="#fff" stroke-width="2" />
                <path d="M30 262H390" stroke="#fff" stroke-opacity=".18" stroke-width="1.5" />
                <path d="M330 262V120M312 120h36l-8-34h-20Z" stroke="#fff" stroke-width="2.2" />
                <path d="M300 86 L360 86 L400 262 H260Z" fill={`url(#${uid}-cone)`} stroke="none" opacity=".25" />
                <rect x="110" y="70" width="110" height="80" rx="4" stroke="#fff" stroke-opacity=".6" stroke-width="1.8" />
                <path d="M126 130c18-24 34-36 50-22 10 8 18 4 28-10" stroke="#b5ee3a" stroke-width="1.8" />
              </>
            )}
            {scene === 'portrait' && (
              <>
                <circle cx="200" cy="118" r="40" stroke="#fff" stroke-width="2.4" />
                <path d="M104 300c4-66 42-104 96-104s92 38 96 104" stroke="#fff" stroke-width="2.4" />
                <path d="M176 200l24 50 24-50M200 250v50" stroke="#fff" stroke-width="2" />
                <path d="M236 214c14 12 18 32 10 50-6 12-22 14-30 4" stroke="#b5ee3a" stroke-width="2" />
                <circle cx="214" cy="266" r="6" stroke="#b5ee3a" stroke-width="2" />
              </>
            )}
          </g>
        </svg>
        {flags.placeholderBadges && (
          <span class="ph-badge absolute bottom-3 left-3" data-placeholder>
            Placeholder · {label}
          </span>
        )}
      </>
    )
  }
  <slot />
</div>
