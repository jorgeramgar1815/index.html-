---
/** Cifras de confianza con contadores animados. */
import Icon from './Icon.astro';
import PlaceholderBadge from './PlaceholderBadge.astro';
import { trust } from '../data/site';
---

<section aria-label="Dental MX en cifras" class="relative py-16 sm:py-20">
  <div class="container-x">
    <ul class="grid grid-cols-2 gap-y-10 lg:grid-cols-4">
      {
        trust.map((t, i) => (
          <li class:list={['relative flex flex-col items-center px-3 text-center', i > 0 && 'lg:border-l lg:border-line', i % 2 === 1 && 'max-lg:border-l max-lg:border-line']} data-reveal style={`--i:${i}`}>
            <span class="icon-tube size-11"><Icon name={t.icon} size={22} /></span>
            <span class="mt-4 font-display text-4xl leading-none font-extrabold text-white sm:text-5xl">
              {t.value !== undefined ? (
                <>
                  {/* PLACEHOLDER (si aplica): cifra por confirmar con el cliente */}
                  <span data-count={t.value}>{t.value.toLocaleString('es-MX')}</span>
                  <span class="text-neon">{t.suffix}</span>
                </>
              ) : (
                <span class="text-2xl sm:text-3xl">{t.text}</span>
              )}
            </span>
            <span class="mt-2 text-sm text-mute">{t.label}</span>
            {t.placeholder && <PlaceholderBadge label="Por confirmar" class="mt-2 scale-90" />}
          </li>
        ))
      }
    </ul>
  </div>
</section>
