---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PlaceholderBadge from '../components/PlaceholderBadge.astro';
import { site } from '../data/site';
---

<BaseLayout title="Aviso de privacidad | Dental MX" description="Aviso de privacidad de Dental MX, clínica dental en Torreón, Coahuila.">
  <PageHeader crumb="Aviso de privacidad" title="Aviso de privacidad" />
  <section class="pb-24">
    <div class="container-x max-w-3xl">
      <PlaceholderBadge label="Texto legal pendiente" />
      {/* PLACEHOLDER: sustituir por el aviso de privacidad integral redactado/validado por el cliente (LFPDPPP). */}
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-snow/80">
        <p>
          {site.name}, con domicilio en {site.address.full}, es responsable del uso y protección de los datos personales que nos proporcionas al
          contactarnos por WhatsApp, teléfono o en el consultorio.
        </p>
        <p>
          Utilizamos tus datos únicamente para agendar y dar seguimiento a tus citas, integrar tu expediente clínico y comunicarte información sobre tus
          tratamientos. No compartimos tu información con terceros sin tu consentimiento, salvo en los casos previstos por la ley.
        </p>
        <p>
          Puedes ejercer tus derechos de acceso, rectificación, cancelación u oposición (ARCO) escribiéndonos al {site.phone.display}.
        </p>
        <p class="text-mute">Este texto es provisional y será reemplazado por el aviso de privacidad integral de la clínica.</p>
      </div>
    </div>
  </section>
</BaseLayout>
