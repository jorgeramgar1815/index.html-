---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import NeonTooth from '../components/NeonTooth.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import TrustBar from '../components/TrustBar.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import TipCard from '../components/TipCard.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Photo from '../components/Photo.astro';
import MapEmbed from '../components/MapEmbed.astro';
import HoursList from '../components/HoursList.astro';
import PlaceholderBadge from '../components/PlaceholderBadge.astro';
import { faqs, flags, reasons, services, site, testimonials, tips, waLink } from '../data/site';

const promos = services.filter((s) => s.promo);

const values = [
  { icon: 'tooth', title: 'Salud bucal', text: 'Prevenir antes que curar.' },
  { icon: 'shield', title: 'Confianza', text: 'Diagnósticos honestos y claros.' },
  { icon: 'leaf', title: 'Bienestar', text: 'Visitas cómodas y sin prisa.' },
];

// PLACEHOLDER: fotos del consultorio. Agregar `src: '/img/...'` cuando el cliente las entregue (pregunta #4).
const gallery = [
  { scene: 'reception' as const, alt: 'Recepción de Dental MX con letrero de neón', label: 'Recepción', src: '' },
  { scene: 'chair' as const, alt: 'Área de tratamiento con sillón dental', label: 'Consultorio', src: '' },
  { scene: 'lounge' as const, alt: 'Sala de espera con iluminación cálida', label: 'Sala de espera', src: '' },
];

const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'ItemList',
    name: 'Servicios de Dental MX',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: { '@type': 'MedicalProcedure', name: s.name, description: s.description, url: new URL(`/#${s.slug}`, Astro.site).href },
    })),
  },
];

// PLACEHOLDER: ruta a foto/video real del consultorio para el fondo del hero (vacío = escena de marca).
const heroImage = '';
---

<BaseLayout schema={schema}>
  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-28 pb-28 sm:pt-32 sm:pb-36">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -inset-x-0 -top-[10%] h-[120%] will-change-transform" data-parallax="0.22">
        {
          heroImage ? (
            <img src={heroImage} alt="" class="size-full object-cover" fetchpriority="high" />
          ) : (
            <div class="size-full wood-slats opacity-80" />
          )
        }
      </div>
      <!-- overlay oscuro + luz cálida + glow verde -->
      <div class="absolute inset-0 bg-[linear-gradient(100deg,rgb(14_16_14/0.97)_0%,rgb(14_16_14/0.88)_45%,rgb(14_16_14/0.55)_100%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_75%_0%,rgb(255_184_112/0.18),transparent_55%)]"></div>
      <div class="absolute top-1/2 right-[8%] size-[34rem] -translate-y-1/2 rounded-full bg-lime/20 blur-[140px] max-lg:top-[18%] max-lg:right-[-30%] max-lg:size-[22rem]"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink to-transparent"></div>
      <div class="grain absolute inset-0"></div>
    </div>

    <div class="container-x grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="relative">
        <p class="eyebrow hero-in" style="--i:0">Clínica dental · Torreón</p>
        <h1 class="hero-in mt-6 text-[2.6rem] leading-[1.02] font-extrabold tracking-tight sm:text-6xl lg:text-7xl" style="--i:1">
          Tu sonrisa<br class="sm:hidden" /> en manos
          <span class="script-neon mt-1 block pr-2 text-[3.6rem] leading-[1.05] sm:text-[5.2rem] lg:text-[6.2rem]">profesionales</span>
        </h1>
        <p class="hero-in mt-6 max-w-xl text-lg leading-relaxed text-snow/80 sm:text-xl" style="--i:2">
          Cuidado dental integral para toda la familia. Tecnología, trato cercano y precios accesibles, a un mensaje de distancia.
        </p>
        <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row" style="--i:3">
          <WhatsAppButton size="lg" message="Hola, me gustaría agendar una cita en Dental MX." cta="hero-whatsapp" />
          <a href="#servicios" class="btn btn-ghost btn-lg">
            Ver servicios <Icon name="arrow-right" size={18} />
          </a>
        </div>
        <p class="hero-in mt-8 flex items-center gap-2 text-sm text-mute" style="--i:4">
          <Icon name="pin" size={16} class="text-lime" />
          {site.address.street} · {site.address.neighborhood}
        </p>
      </div>

      <div class="pointer-events-none absolute top-24 -right-10 w-44 opacity-35 sm:w-56 lg:pointer-events-auto lg:relative lg:top-auto lg:right-auto lg:w-auto lg:opacity-100" aria-hidden="true">
        <NeonTooth flicker class="mx-auto w-full max-w-[22rem]" />
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- ═══════════════ SERVICIOS ═══════════════ -->
  <section class="section" id="servicios">
    <div class="container-x">
      <SectionHeading
        eyebrow="Servicios"
        title='Todo lo que tu sonrisa necesita, <span class="text-neon">en un solo lugar</span>'
        intro="Desde una limpieza hasta un implante: tratamientos completos para cada etapa de la vida, con un plan claro desde la primera cita. Pregunta por el tuyo directo por WhatsApp."
      />
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => <ServiceCard service={s} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ═══════════════ PROMOCIONES ═══════════════ -->
  {
    flags.showPrices && promos.length > 0 && (
      <section class="pb-20 sm:pb-24 lg:pb-32" aria-labelledby="promos-title">
        <div class="container-x">
          <div class="grain relative overflow-hidden rounded-[2rem] border border-lime/25 bg-surface p-6 sm:p-10 lg:p-14" data-reveal>
            <div class="pointer-events-none absolute -top-32 -right-20 size-[26rem] rounded-full bg-lime/20 blur-[120px]" aria-hidden="true" />
            <div class="pointer-events-none absolute inset-0 grid-fade opacity-60" aria-hidden="true" />
            <div class="relative grid grid-cols-1 items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <p class="eyebrow">Promociones</p>
                  <PlaceholderBadge label="Precios por confirmar" />
                </div>
                <h2 id="promos-title" class="mt-4 text-3xl leading-[1.1] font-bold sm:text-4xl lg:text-5xl">
                  Estrena <span class="script-neon text-[1.25em] font-normal">sonrisa</span> sin romper tu presupuesto
                </h2>
                <p class="mt-5 text-lg text-mute">Aparta tu lugar por WhatsApp. Cupo limitado y sujeto a valoración.</p>
              </div>
              {/* PLACEHOLDER: promociones vistas en Facebook; confirmar vigencia antes de publicar. */}
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {promos.map((s) => (
                  <div class="flex flex-col rounded-2xl border border-line bg-ink/60 p-6 backdrop-blur">
                    <span class="icon-tube"><Icon name={s.icon} size={24} /></span>
                    <p class="mt-5 text-sm font-semibold tracking-[0.14em] text-mute uppercase">{s.name}</p>
                    <p class="mt-2 flex items-baseline gap-3">
                      {s.promo!.was && <s class="text-lg text-mute">{s.promo!.was}</s>}
                      <strong class="font-display text-4xl font-extrabold text-lime">{s.promo!.now}</strong>
                    </p>
                    {s.promo!.note && <p class="mt-1 text-sm text-mute">{s.promo!.note}</p>}
                    <a
                      href={waLink(`Hola, me interesa la promoción de ${s.name.toLowerCase()} (${s.promo!.now}).`)}
                      target="_blank"
                      rel="noopener"
                      class="btn btn-primary mt-6 min-h-11 px-5 text-sm"
                      data-cta={`promo-${s.slug}`}
                    >
                      <Icon name="whatsapp" size={17} /> Aprovechar promoción
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ═══════════════ POR QUÉ ELEGIRNOS ═══════════════ -->
  <section class="on-light section bg-paper text-ink">
    <div class="container-x grid grid-cols-1 items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="relative" data-reveal>
        <Photo scene="chair" alt="Sillón dental del consultorio Dental MX" class="aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5]" />
        <div class="absolute -right-3 -bottom-6 max-w-[15rem] rounded-2xl bg-ink p-5 text-snow shadow-[var(--shadow-lift)] sm:-right-6">
          <p class="font-display text-sm font-semibold text-lime">{site.values.join(' · ')}</p>
          <p class="mt-2 text-sm text-mute">Un consultorio pensado para que te sientas en confianza.</p>
        </div>
      </div>
      <div>
        <SectionHeading
          eyebrow="Por qué elegirnos"
          title="Profesionalismo de especialista, trato de familia"
          intro="Nos importa tanto tu salud bucal como que salgas tranquilo de cada cita."
        />
        <div class="mt-12 grid gap-5 sm:grid-cols-2">
          {
            reasons.map((r, i) => (
              <div class="card p-6" data-reveal style={`--i:${i}`}>
                <span class="icon-tube"><Icon name={r.icon} size={24} /></span>
                <h3 class="mt-5 text-lg font-bold">{r.title}</h3>
                <p class="mt-2 leading-relaxed text-slate">{r.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ ANTES / DESPUÉS ═══════════════ -->
  <section class="section relative overflow-hidden">
    <div class="pointer-events-none absolute -left-40 top-1/3 size-[30rem] rounded-full bg-lime/10 blur-[130px]" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <SectionHeading
        eyebrow="Antes y después"
        title="Resultados que se notan desde la primera sonrisa"
        intro="Cada tratamiento se diseña a tu medida. Así se ve el cambio que buscamos lograr contigo."
      >
        <div class="mt-8">
          <WhatsAppButton label="Quiero mi valoración" message="Hola, quiero agendar una valoración para ver qué tratamiento me conviene." cta="before-after" />
        </div>
      </SectionHeading>
      <BeforeAfter />
    </div>
  </section>

  <!-- ═══════════════ NOSOTROS ═══════════════ -->
  <section class="section overflow-hidden bg-ink-2" id="nosotros">
    <div class="container-x">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
        <div class="relative mx-auto w-full max-w-md" data-reveal>
          <div class="pointer-events-none absolute -inset-6 rounded-[2rem] bg-lime/15 blur-3xl" aria-hidden="true"></div>
          {/* PLACEHOLDER: foto del doctor — definir `site.doctor.photo` en src/data/site.ts */}
          <Photo scene="portrait" src={site.doctor.photo} alt={flags.showDoctorName ? `Retrato de ${site.doctor.name}` : 'Retrato del director clínico'} label="Foto del doctor" class="relative aspect-[4/5]" />
        </div>
        <div data-reveal style="--i:1">
          <div class="flex flex-wrap items-center gap-3">
            <p class="eyebrow">Nosotros</p>
            <PlaceholderBadge label="Textos por confirmar" />
          </div>
          <h2 class="mt-4 text-3xl leading-[1.1] font-bold sm:text-4xl lg:text-5xl">
            Una clínica de barrio con estándares <span class="text-neon">de especialista</span>
          </h2>
          {/* PLACEHOLDER: historia de la clínica — reemplazar con la versión del cliente. */}
          <p class="mt-5 text-lg leading-relaxed text-snow/80">
            Dental MX nació en Torreón Residencial para que las familias de la zona tengan un consultorio moderno, cómodo y honesto, donde cada tratamiento se explica con palabras claras y precios justos.
          </p>

          <div class="mt-8 rounded-2xl border border-line bg-ink/50 p-6">
            <p class="font-display text-xl font-bold text-white">{flags.showDoctorName ? site.doctor.name : 'Nuestro director clínico'}</p>
            <p class="mt-1 font-display text-sm font-semibold text-lime">{site.doctor.role}</p>
            <p class="mt-0.5 text-sm text-mute">{site.doctor.license}</p>
            <p class="mt-4 leading-relaxed text-snow/80">{site.doctor.bio[0]}</p>
          </div>

          <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
            {
              values.map((v) => (
                <li class="flex items-center gap-3 rounded-2xl border border-line p-4 sm:flex-col sm:items-start">
                  <span class="icon-tube size-10"><Icon name={v.icon} size={20} /></span>
                  <span>
                    <span class="block font-display font-semibold text-white">{v.title}</span>
                    <span class="block text-sm text-mute">{v.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-3 lg:mt-20">
        {
          gallery.map((g, i) => (
            <div data-reveal style={`--i:${i}`}>
              <Photo scene={g.scene} src={g.src} alt={g.alt} label={g.label} class="aspect-[4/3]" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════ TESTIMONIOS ═══════════════ -->
  <section class="section" id="testimonios">
    <div class="container-x">
      <SectionHeading
        align="center"
        eyebrow="Testimonios"
        title='Sonrisas que <span class="text-neon">hablan por nosotros</span>'
        intro="Lo que dicen las familias que ya se atienden en Dental MX."
      />
      {/* PLACEHOLDER: testimonios de ejemplo — reemplazar en src/data/site.ts (estructura lista para 3–6). */}
      <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((t, i) => <TestimonialCard testimonial={t} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ═══════════════ TIPS ═══════════════ -->
  <section class="section pt-0 sm:pt-0 lg:pt-0">
    <div class="container-x">
      <SectionHeading
        eyebrow="Tips Dental MX"
        title="Pequeños hábitos, sonrisas más sanas"
        intro="Consejos prácticos de nuestro consultorio para cuidar tus tratamientos en casa."
      />
      <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {tips.map((t, i) => <TipCard tip={t} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ═══════════════ PREGUNTAS FRECUENTES ═══════════════ -->
  <section class="section bg-ink-2" id="preguntas">
    <div class="container-x grid grid-cols-1 gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <SectionHeading eyebrow="Preguntas frecuentes" title="Lo que más nos preguntan" intro="¿No encuentras tu respuesta? Escríbenos y te orientamos sin compromiso.">
        <WhatsAppButton class="mt-8" variant="ghost" label="Hacer una pregunta" message="Hola, tengo una duda sobre un tratamiento." cta="faq" />
      </SectionHeading>
      <div class="divide-y divide-line border-y border-line" data-reveal>
        {
          faqs.map((f) => (
            <details class="group py-2">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 font-display text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="grid size-9 shrink-0 place-items-center rounded-full border border-line text-lime transition-transform duration-300 group-open:rotate-45">
                  <Icon name="plus" size={18} />
                </span>
              </summary>
              <p class="pr-12 pb-5 leading-relaxed text-mute">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════ CTA FINAL + MAPA ═══════════════ -->
  <section class="section" id="contacto">
    <div class="container-x">
      <div class="grain relative overflow-hidden rounded-[2rem] border border-lime/20 bg-surface" data-reveal>
        <div class="pointer-events-none absolute -top-40 -left-24 size-[26rem] rounded-full bg-lime/15 blur-[120px]" aria-hidden="true"></div>
        <div class="relative grid grid-cols-1 lg:grid-cols-2">
          <div class="p-6 sm:p-12 lg:p-14">
            <p class="eyebrow">Contacto</p>
            <h2 class="mt-4 text-3xl leading-[1.1] font-bold sm:text-4xl lg:text-5xl">
              Agenda hoy y <span class="script-neon text-[1.3em] font-normal">sonríe</span> mañana
            </h2>
            <p class="mt-5 text-lg text-mute">Escríbenos por WhatsApp y te confirmamos tu cita. Así de fácil.</p>

            <address class="mt-8 space-y-4 not-italic">
              <p class="flex gap-3">
                <Icon name="pin" size={22} class="mt-0.5 shrink-0 text-lime" />
                <span>{site.address.street}<br /><span class="text-mute">{site.address.neighborhood}, {site.address.postalCode} {site.address.city}, Coah.</span></span>
              </p>
              <p class="flex items-center gap-3">
                <Icon name="phone" size={22} class="shrink-0 text-lime" />
                <a href={`tel:${site.phone.tel}`} class="underline-offset-4 hover:text-lime hover:underline">{site.phone.display}</a>
              </p>
            </address>

            <div class="mt-8 rounded-2xl border border-line bg-ink/40 p-5">
              <HoursList><h3 class="flex items-center gap-2 font-display font-semibold"><Icon name="clock" size={20} class="text-lime" /> Horario</h3></HoursList>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <WhatsAppButton size="lg" cta="final-whatsapp" />
              <a href={`tel:${site.phone.tel}`} class="btn btn-ghost btn-lg"><Icon name="phone" size={18} /> Llamar</a>
            </div>
            <div class="mt-6 flex items-center gap-3 text-sm text-mute">
              Síguenos:
              <a href={site.social.instagram.url} target="_blank" rel="noopener" class="grid size-11 place-items-center rounded-full border border-line text-snow transition-colors hover:border-lime hover:text-lime" aria-label={`Instagram ${site.social.instagram.handle}`}><Icon name="instagram" size={19} /></a>
              <a href={site.social.facebook.url} target="_blank" rel="noopener" class="grid size-11 place-items-center rounded-full border border-line text-snow transition-colors hover:border-lime hover:text-lime" aria-label="Facebook Dental MX"><Icon name="facebook" size={19} /></a>
            </div>
          </div>
          <MapEmbed class="min-h-[22rem] rounded-none border-0 border-t border-line lg:min-h-full lg:border-t-0 lg:border-l" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
