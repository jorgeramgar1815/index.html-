---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceVisual from '../components/ServiceVisual.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import PlaceholderBadge from '../components/PlaceholderBadge.astro';
import Icon from '../components/Icon.astro';
import { faqs, flags, services } from '../data/site';

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: new URL('/servicios/', Astro.site).href },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'ItemList',
    name: 'Servicios de Dental MX',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: { '@type': 'MedicalProcedure', name: s.name, description: s.description, url: new URL(`/servicios/#${s.slug}`, Astro.site).href },
    })),
  },
];
---

<BaseLayout
  title="Servicios dentales en Torreón | Ortodoncia, implantes y blanqueamiento — Dental MX"
  description="Piezas dentales, resinas estéticas, ortodoncia, implantes, blanqueamiento y atención personalizada en Torreón. Conoce cada tratamiento y agenda por WhatsApp."
  schema={schema}
>
  <PageHeader
    crumb="Servicios"
    eyebrow="Nuestros servicios"
    title='Tratamientos completos para <span class="text-neon">cada sonrisa</span>'
    intro="Seis áreas de atención con un mismo compromiso: explicarte todo con claridad, cuidar tu comodidad y darte resultados que duren."
  >
    <nav aria-label="Servicios" class="hero-in mt-10 -mx-4 overflow-x-auto px-4 pb-2 [scrollbar-width:none]" style="--i:4">
      <ul class="flex w-max gap-2">
        {
          services.map((s) => (
            <li>
              <a href={`#${s.slug}`} class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-white/[0.03] px-4 text-sm font-medium text-snow/80 transition-colors hover:border-lime hover:text-lime">
                <Icon name={s.icon} size={18} class="text-lime" />
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHeader>

  <div class="container-x space-y-24 pb-8 sm:space-y-32 lg:space-y-40">
    {
      services.map((s, i) => (
        <article id={s.slug} class="grid scroll-mt-28 items-center gap-10 lg:grid-cols-2 lg:gap-20">
          <div class:list={['relative', i % 2 === 1 && 'lg:order-2']} data-reveal>
            <ServiceVisual service={s} index={i} />
            {flags.showPrices && s.promo && (
              /* PLACEHOLDER: precio promocional visto en Facebook; confirmar vigencia con el cliente. */
              <div class:list={['absolute -bottom-6 rounded-2xl border border-lime/30 bg-ink/95 px-5 py-4 shadow-[var(--shadow-lift)] backdrop-blur', i % 2 === 1 ? 'left-4 sm:-left-6' : 'right-4 sm:-right-6']}>
                <p class="text-xs font-semibold tracking-[0.16em] text-mute uppercase">{s.promo.label}</p>
                <p class="mt-1 flex items-baseline gap-2">
                  {s.promo.was && <s class="text-mute">{s.promo.was}</s>}
                  <strong class="font-display text-2xl font-extrabold text-lime">{s.promo.now}</strong>
                </p>
                {s.promo.note && <p class="mt-1 text-xs text-mute">{s.promo.note}</p>}
                <PlaceholderBadge label="Precio por confirmar" class="mt-2" />
              </div>
            )}
          </div>

          <div data-reveal style="--i:1">
            <p class="eyebrow">{String(i + 1).padStart(2, '0')} · Servicio</p>
            <h2 class="mt-4 text-3xl font-bold sm:text-4xl lg:text-5xl">{s.name}</h2>
            <p class="mt-5 text-lg leading-relaxed text-snow/80">{s.description}</p>

            <h3 class="mt-8 font-display text-sm font-semibold tracking-[0.14em] text-mute uppercase">¿Para quién es?</h3>
            <ul class="mt-4 space-y-3">
              {s.forWho.map((f) => (
                <li class="flex gap-3 leading-relaxed">
                  <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-lime/15 text-lime">
                    <Icon name="check" size={14} strokeWidth={2.4} />
                  </span>
                  <span class="text-snow/90">{f}</span>
                </li>
              ))}
            </ul>

            <WhatsAppButton class="mt-9" label={`Preguntar por ${s.name.toLowerCase()}`} message={s.waMessage} cta={`service-${s.slug}`} />
          </div>
        </article>
      ))
    }
  </div>

  <!-- Preguntas frecuentes -->
  <section class="section mt-16 bg-ink-2" aria-labelledby="faq-title">
    <div class="container-x grid grid-cols-1 gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <SectionHeading eyebrow="Dudas frecuentes" title="Lo que más nos preguntan" intro="¿No encuentras tu respuesta? Escríbenos y te orientamos sin compromiso.">
        <WhatsAppButton class="mt-8" variant="ghost" label="Hacer una pregunta" message="Hola, tengo una duda sobre un tratamiento." cta="faq" />
      </SectionHeading>
      <div class="divide-y divide-line border-y border-line" data-reveal>
        {
          faqs.map((f) => (
            <details class="faq group py-2">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 font-display text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="grid size-9 shrink-0 place-items-center rounded-full border border-line text-lime transition-transform duration-300 group-open:rotate-45">
                  <Icon name="plus" size={18} />
                </span>
              </summary>
              <p class="pr-12 pb-5 leading-relaxed text-mute">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title='¿No sabes qué tratamiento necesitas? <span class="text-neon">Empecemos por una valoración.</span>'
    message="Hola, quiero agendar una valoración general."
    cta="services-cta"
  />
</BaseLayout>
