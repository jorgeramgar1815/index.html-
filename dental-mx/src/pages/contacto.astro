---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import MapEmbed from '../components/MapEmbed.astro';
import HoursList from '../components/HoursList.astro';
import Icon from '../components/Icon.astro';
import { site, waLink } from '../data/site';

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Contacto', item: new URL('/contacto/', Astro.site).href },
    ],
  },
];
---

<BaseLayout
  title="Contacto | Dental MX — Dentista en Torreón Residencial"
  description={`Agenda tu cita en Dental MX por WhatsApp al ${site.phone.display}. ${site.address.full}.`}
  schema={schema}
>
  <PageHeader
    crumb="Contacto"
    eyebrow="Contacto"
    title='Agenda tu cita en <span class="script-neon font-normal text-[1.2em]">un mensaje</span>'
    intro="Escríbenos por WhatsApp con el servicio que te interesa y el horario que prefieres. Te respondemos para confirmar tu cita."
  >
    <div class="hero-in mt-10 flex flex-col gap-3 sm:flex-row" style="--i:4">
      <WhatsAppButton size="lg" label="Escribir por WhatsApp" cta="contact-hero" />
      <a href={`tel:${site.phone.tel}`} class="btn btn-ghost btn-lg"><Icon name="phone" size={18} /> {site.phone.display}</a>
    </div>
  </PageHeader>

  <section class="pb-20 sm:pb-28">
    <div class="container-x grid grid-cols-1 gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
        <div class="card p-6 sm:p-8" data-reveal>
          <span class="icon-tube"><Icon name="pin" size={24} /></span>
          <h2 class="mt-5 text-xl font-bold">Dirección</h2>
          <address class="mt-3 leading-relaxed text-snow/85 not-italic">
            {site.address.street}<br />
            {site.address.neighborhood}, {site.address.postalCode}<br />
            {site.address.city}, {site.address.region}, México
          </address>
          <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.maps.query)}`} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 font-display text-sm font-semibold text-lime hover:underline">
            Cómo llegar <Icon name="arrow-up-right" size={16} />
          </a>
        </div>

        <div class="card p-6 sm:p-8" data-reveal style="--i:1">
          <span class="icon-tube"><Icon name="chat" size={24} /></span>
          <h2 class="mt-5 text-xl font-bold">Teléfono y WhatsApp</h2>
          <ul class="mt-3 space-y-2">
            <li><a href={waLink()} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 text-snow/85 hover:text-lime"><Icon name="whatsapp" size={18} class="text-lime" /> WhatsApp: {site.phone.intl}</a></li>
            <li><a href={`tel:${site.phone.tel}`} class="inline-flex min-h-11 items-center gap-2 text-snow/85 hover:text-lime"><Icon name="phone" size={18} class="text-lime" /> Llamar: {site.phone.display}</a></li>
          </ul>
        </div>

        <div class="card p-6 sm:col-span-2 sm:p-8 lg:col-span-1" data-reveal style="--i:2">
          <HoursList>
            <h2 class="flex items-center gap-3 text-xl font-bold"><span class="icon-tube size-10"><Icon name="clock" size={20} /></span> Horario</h2>
          </HoursList>
        </div>

        <div class="card p-6 sm:col-span-2 sm:p-8 lg:col-span-1" data-reveal style="--i:3">
          <h2 class="text-xl font-bold">Síguenos</h2>
          <p class="mt-2 text-mute">Tips, promociones y casos del consultorio.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={site.social.instagram.url} target="_blank" rel="noopener" class="btn btn-ghost min-h-11 px-5 text-sm"><Icon name="instagram" size={18} /> {site.social.instagram.handle}</a>
            <a href={site.social.facebook.url} target="_blank" rel="noopener" class="btn btn-ghost min-h-11 px-5 text-sm"><Icon name="facebook" size={18} /> Facebook</a>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <MapEmbed class="min-h-[24rem] flex-1 lg:min-h-[32rem]" />
        <div class="grain relative overflow-hidden rounded-[var(--radius-card)] border border-lime/25 bg-surface p-6 sm:p-10" data-reveal>
          <div class="pointer-events-none absolute -right-20 -bottom-24 size-72 rounded-full bg-lime/20 blur-[90px]" aria-hidden="true"></div>
          <div class="relative">
            <h2 class="text-2xl font-bold sm:text-3xl">¿Listo para tu cita?</h2>
            <p class="mt-3 text-mute">Sin formularios ni esperas: mándanos un WhatsApp y listo.</p>
            <WhatsAppButton size="lg" class="mt-7 w-full" label="Agendar por WhatsApp" cta="contact-main" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
